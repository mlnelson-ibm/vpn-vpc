########################################################################################################################
# Terraform Variables Template
# 
# Copy this file to terraform.tfvars and fill in your values
# Command: cp terraform.tfvars.template terraform.tfvars
########################################################################################################################

# IBM Cloud API Key (REQUIRED)
# Get your API key from: https://cloud.ibm.com/iam/apikeys
ibmcloud_api_key = "YOUR_IBM_CLOUD_API_KEY_HERE"

# Region (Optional - defaults to us-south)
# Available regions: us-south, us-east, eu-gb, eu-de, jp-tok, au-syd, etc.
# region = "us-south"

# Resource Prefix (Optional - defaults to vpn-vpc)
# This prefix will be added to all resource names
# prefix = "vpn-vpc"

# Resource Tags (Optional)
# Add tags to help organize and track your resources
# resource_tags = ["environment:production", "project:vpn", "owner:team"]

########################################################################################################################
# VPC Configuration
########################################################################################################################

# VPC Address Prefix (Optional - defaults to 10.10.0.0/20)
# CIDR block for the VPC - must not overlap with vpn_client_ip_pool
# vpc_address_prefix = "10.10.0.0/20"

########################################################################################################################
# VPN Configuration
########################################################################################################################

# VPN Client IP Pool (Optional - defaults to 10.0.0.0/20)
# CIDR block for VPN client IP addresses - must not overlap with VPC CIDR
# vpn_client_ip_pool = "10.0.0.0/20"

# VPN Client Users (Optional)
# List of IBM Cloud IAM user email addresses to grant VPN access
# Users must already exist in your IBM Cloud account
# vpn_client_access_group_users = [
#   "user1@example.com",
#   "user2@example.com"
# ]

# Create VPN Access Policy (Optional - defaults to true)
# Set to false if you want to manage IAM access separately
# create_vpn_access_policy = true

# VPN Protocol (Optional - defaults to udp)
# Valid values: "udp" or "tcp"
# vpn_protocol = "udp"

# VPN Client Idle Timeout (Optional - defaults to 1800 seconds / 30 minutes)
# Set to 0 to disable timeout
# vpn_client_idle_timeout = 1800

########################################################################################################################
# Certificate Configuration
########################################################################################################################

# Certificate Common Name (Optional - defaults to vpn.example.com)
# The domain name for the VPN server certificate
# certificate_common_name = "vpn.example.com"

# Root CA Maximum TTL (Optional - defaults to 87600h / 10 years)
# root_ca_max_ttl = "87600h"

# Intermediate CA Maximum TTL (Optional - defaults to 26300h / 3 years)
# intermediate_ca_max_ttl = "26300h"

# Certificate Template Maximum TTL (Optional - defaults to 8760h / 1 year)
# certificate_template_max_ttl = "8760h"